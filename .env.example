# AIS voice service (Phase 2) — copy to .env and fill in. Never commit .env.
# No key is needed to run the tests: fakes build the pipeline offline.

# Brain mode: "anthropic" (default, live LLM) or "muse-operator"
# (turn-based: STT -> pending queue -> Muse replies -> TTS; no key).
BRAIN_MODE=anthropic

# Claude (LLM) — Pipecat 1.15 requires the Anthropic 1.x SDK.
ANTHROPIC_API_KEY=
# Gateway (optional): Anthropic-compatible endpoint, e.g. Nagoya Router.
# Empty = official api.anthropic.com. For Anthropic-protocol gateways
# the base URL has NO trailing /v1 (the SDK appends /v1/messages).
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Deepgram (STT) — REST pre-recorded /v1/listen over HTTPS, one request
# per VAD segment. The streaming service is NOT used: this VM's egress
# proxy refuses WebSocket upgrades to api.deepgram.com.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Cartesia (TTS, Sonic 3 family). Pick a voice in the Cartesia dashboard
# and paste its ID here — no default voice is invented. REST /tts/bytes
# over HTTPS (raw PCM s16le 24 kHz); streaming is blocked by the same
# egress-proxy WebSocket refusal as STT.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# Offer — dental clinic website redesign (Himmah practice).
AGENCY_NAME=AISIMA
SERVICE_NAME=Website Redesign for Dental Clinics
SERVICE_PRICE=$1,000 one-time
TARGET_MARKET=USA — Texas, Florida, California dental clinics

# Recording is OFF by default. CA + FL are all-party consent states:
# only enable with an announcement + explicit consent (see PHASE2_PLAN.md §3.2).
RECORDING_ENABLED=false

# Phase 1 dashboard (text service) — read-only over HTTP, never write its DB.
PHASE1_BASE_URL=http://127.0.0.1:7860

# Twilio trial dial-out (test calls ONLY — see DIAL_TEST.md).
# Trial credit reaches VERIFIED numbers only: TWILIO_TO_NUMBER must be
# Bsr's own phone number, verified in the Twilio console, and the same
# number must have a written-consent row in data/consent.json.
# TWILIO_STREAM_URL is the PUBLIC wss:// URL of /twilio/stream: on the
# laptop run `ngrok http 7861` and use wss://<id>.ngrok-free.app/twilio/stream.
# TWILIO_TEST_MODE=true = self-test only (Phase 1 is not on the laptop,
# so its opt-out check is recorded as n/a). Real clinic dials need
# TEST_MODE=false + Phase 1 reachable. Never commit .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
TWILIO_STREAM_URL=
TWILIO_TEST_MODE=true
TWILIO_TEST_TIMEZONE=Asia/Jakarta
TWILIO_TEST_STATE=

# Local bind for this voice service.
HOST=127.0.0.1
PORT=7861
